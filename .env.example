# Salin menjadi .env (file .env tidak ikut di-commit). Semua variabel opsional; nilai bawaan cukup untuk demo lokal.

# Kunci penandatangan sesi login. Isi string acak panjang (mis. hasil: python -c "import secrets;print(secrets.token_urlsafe(48))").
# Bila kosong, aplikasi membuat kunci acak sendiri di backend/data/secret.key.
PK_SECRET_KEY=

# Akun demo untuk juri (1 = aktif, 0 = mati) dan kata sandinya
PK_DEMO_ACCOUNTS=1
PK_DEMO_PASSWORD=

# Cookie Secure: auto (ikut HTTPS), 1, atau 0
PK_COOKIE_SECURE=auto
PK_SESSION_HOURS=12

# Data satelit: demo (simulasi berlabel, offline) atau live (Sentinel-2 + Hansen, butuh requirements-live.txt)
PK_SATELLITE_MODE=demo

# Cek kawasan hutan: auto (peta Kemenhut + cache + lokal), online, atau lokal
PK_KAWASAN_SOURCE=auto
PK_KAWASAN_URL=
PK_KAWASAN_LAYERS=
PK_KAWASAN_TIMEOUT=10
# Cadangan otomatis bila peta Kemenhut tidak terjangkau: Peta Kawasan Hutan KLHK 2017 dari Global Forest Watch (1 = aktif)
PK_KAWASAN_GFW=
PK_KAWASAN_GFW_URL=

# Lokasi data & database (bawaan: backend/data/pasporkebun.db)
PK_DATA_DIR=
PK_DB_URL=

# Citra untuk AI penggambar batas (XYZ tile) dan zoom
PK_TILE_URL=
PK_TILE_ZOOM=18

# Asal yang boleh memanggil API saat mode pengembangan (Vite di port 5173)
PK_CORS=http://localhost:5173,http://127.0.0.1:5173

# Segment Anything (opsional)
PK_SAM_MODEL=vit_b
PK_SAM_CHECKPOINT=
